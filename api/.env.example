APP_NAME=E-FMS
APP_ENV=production
APP_KEY=base64:GENERATE_A_32_BYTE_RANDOM_KEY
APP_DEBUG=false
APP_URL=https://jms.euodoo.com.ph/api
APP_TIMEZONE=Asia/Manila

LOG_CHANNEL=stack
LOG_SLACK_WEBHOOK_URL=

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u214574264_Efms
DB_USERNAME=u214574264_euodoo
DB_PASSWORD=SET_A_REAL_PASSWORD

CACHE_DRIVER=file
QUEUE_CONNECTION=sync

COMPANY_LOGO_BASE_URL=https://jms.euodoo.com.ph/assets/dist/img/company_logo/

# Internal app URL (no trailing slash) — used in password reset emails
APP_INTERNAL_URL=https://jms.euodoo.com.ph

# Logo URL shown in emails
APP_LOGO_URL=https://jms.euodoo.com.ph/assets/dist/logo_efms.jpg

# API base URL — consumed by the CI internal app (with trailing slash)
APP_API_URL=https://jms.euodoo.com.ph/api/

# CORS - comma-separated origins
CORS_ALLOWED_ORIGINS=https://jms.euodoo.com.ph

# Filesystem path to company logos directory (no trailing slash)
# Leave empty for production (default resolves correctly)
# For local dev set to: C:\xampp\htdocs\be-fms\internal\assets\dist\img\company_logo
COMPANY_LOGO_DIR=

# Traxroot credential encryption key (must match CI_ENCRYPTION_KEY)
TRAXROOT_ENCRYPT_KEY=change_me_generate_32_byte_random_key

# Forstok API credentials
FORSTOK_ID_ID=change_me
FORSTOK_SECRET_ID=change_me
FORSTOK_ACCOUNT_ID=change_me
FORSTOK_ID_MY=change_me
FORSTOK_SECRET_MY=change_me
FORSTOK_ACCOUNT_MY=change_me
FORSTOK_ID_SG=change_me
FORSTOK_SECRET_SG=change_me
FORSTOK_ACCOUNT_SG=change_me

# Mail (Brevo SMTP)
MAIL_DRIVER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-login@smtp-brevo.com
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@jms.euodoo.com.ph
MAIL_FROM_NAME=E-FMS
