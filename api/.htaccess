<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteBase /api/

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Serve existing static files directly (e.g., job photos in storage/)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Let direct /api/public/ requests be handled by public/.htaccess
    RewriteRule ^public(/.*)?$ - [L]

    # Route everything else through index.php (single .htaccess, no chain)
    RewriteRule ^(.*)$ index.php [L]
</IfModule>

# Block sensitive files from direct access
<FilesMatch "\.(env|env\.example|json|lock|md|xml|yml|yaml)$">
    <IfModule authz_core_module>
        Require all denied
    </IfModule>
    <IfModule !authz_core_module>
        Deny from all
    </IfModule>
</FilesMatch>

# Block hidden files (dotfiles)
<FilesMatch "^\.">
    <IfModule authz_core_module>
        Require all denied
    </IfModule>
    <IfModule !authz_core_module>
        Deny from all
    </IfModule>
</FilesMatch>
